{
  "manifest_version": 3,
  "name": "FuneCob Bip",
  "version": "1.4.0",
  "description": "Captura silenciosa de código de barras (leitor externo) e envia ações de baixa/remarcação/retorno para o FuneCob.",
  "permissions": ["storage"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "icons": {
    "48": "icon.png",
    "128": "icon.png"
  }
}
