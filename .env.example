# =====================================================================
# FUNecob — exemplo de configuração de ambiente (FASE 1: app na VPS,
# Supabase atual continua sendo o backend oficial).
# Copie para .env e preencha com os valores reais da sua infraestrutura.
# NUNCA versione o arquivo .env. Nenhum valor real deve entrar aqui.
# =====================================================================

# ---------------------------------------------------------------------
# 1) APP / DOCKER (build e runtime do container web)
# ---------------------------------------------------------------------
NODE_ENV=production
# Porta local em que o container é publicado (o Nginx do host faz o proxy)
APP_PORT=8080
TZ=America/Sao_Paulo

# ---------------------------------------------------------------------
# 2) FRONTEND (públicas — embutidas no bundle em tempo de build)
#    Alterar qualquer VITE_* exige: docker compose up -d --build
# ---------------------------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=
# Domínio oficial de produção do FUNecob / Portal do Cliente
VITE_PORTAL_BASE_URL=https://financeiro.funecob.com.br

# =====================================================================
# 3) BACKEND / EDGE FUNCTIONS (SEGREDOS — configurados via
#    `supabase secrets set`, NUNCA no bundle do frontend).
#    Na Fase 1 as Edge Functions continuam executando no Supabase;
#    estas variáveis ficam aqui apenas como referência/documentação.
# =====================================================================
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=

# ---------------------------------------------------------------------
# 4) EVOLUTION API (WhatsApp) — já instalada na sua VPS
#    Fallback global. Valores por organização continuam vindo do banco
#    (whatsapp_instances) e da tela de Configurações Globais.
# ---------------------------------------------------------------------
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
# Reservado: segredo compartilhado para validar webhooks da Evolution.
# Ainda NÃO é exigido pelo whatsapp-webhook (nenhuma mudança de
# comportamento na Fase 1). Defina o valor agora e a validação poderá ser
# ativada em uma fase futura sem downtime.
EVOLUTION_WEBHOOK_SECRET=

# ---------------------------------------------------------------------
# 5) PORTAL / WEBHOOKS (servidor)
# ---------------------------------------------------------------------
PORTAL_BASE_URL=https://financeiro.funecob.com.br

# ---------------------------------------------------------------------
# 6) OCR / IA (leitura de comprovantes PIX)
#    GEMINI_API_KEY = provedor principal recomendado.
#    LOVABLE_API_KEY = fallback OPCIONAL. Sem chave, o comportamento
#    atual é preservado: o comprovante vai para revisão manual.
# ---------------------------------------------------------------------
GEMINI_API_KEY=
LOVABLE_API_KEY=
