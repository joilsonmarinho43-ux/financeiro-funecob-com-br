# =====================================================================
# FUNecob — exemplo de configuração de ambiente
# Copie para .env e preencha com os valores reais da sua infraestrutura.
# NUNCA versione o arquivo .env.
# =====================================================================

# ---------------------------------------------------------------------
# APP (frontend / build)
# ---------------------------------------------------------------------
# Ambiente de execução do build
NODE_ENV=production
# Porta em que o container do frontend será exposto na VPS
APP_PORT=8080
# Timezone dos containers
TZ=America/Sao_Paulo

# ---------------------------------------------------------------------
# BACKEND SUPABASE (banco + auth + storage + edge functions)
# Estes valores são PÚBLICOS (chave anon/publishable) e são embutidos
# no bundle do frontend durante o build.
# ---------------------------------------------------------------------
VITE_SUPABASE_URL=https://SEU_PROJETO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOi...SUA_CHAVE_ANON
VITE_SUPABASE_PROJECT_ID=seu_project_ref

# ---------------------------------------------------------------------
# PORTAL DO CLIENTE
# Domínio público usado nos links enviados por WhatsApp.
# ---------------------------------------------------------------------
VITE_PORTAL_BASE_URL=https://financeiro.seudominio.com.br

# =====================================================================
# A partir daqui: SEGREDOS DE SERVIDOR.
# Usados apenas pelas Edge Functions / backend. NÃO vão para o frontend.
# =====================================================================

# ---------------------------------------------------------------------
# SUPABASE — SERVIDOR
# ---------------------------------------------------------------------
SUPABASE_URL=https://SEU_PROJETO.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...SUA_CHAVE_ANON
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...SUA_SERVICE_ROLE
SUPABASE_DB_URL=postgresql://usuario:senha@host:5432/postgres

# ---------------------------------------------------------------------
# EVOLUTION API (WhatsApp) — instalada na sua VPS
# Fallback global. Valores por organização continuam vindo do banco
# (whatsapp_instances) e da tela de Configurações Globais.
# ---------------------------------------------------------------------
EVOLUTION_API_URL=http://evolution-api:8080
EVOLUTION_API_KEY=SUA_GLOBAL_API_KEY_DA_EVOLUTION

# ---------------------------------------------------------------------
# PORTAL / WEBHOOKS (servidor)
# Base pública usada pelas Edge Functions ao montar links do portal.
# ---------------------------------------------------------------------
PORTAL_BASE_URL=https://financeiro.seudominio.com.br

# ---------------------------------------------------------------------
# OCR / IA (leitura de comprovantes PIX)
# Opcionais: se ausentes, o OCR por IA é ignorado e o fluxo cai em
# revisão manual, sem quebrar o sistema.
# ---------------------------------------------------------------------
GEMINI_API_KEY=
LOVABLE_API_KEY=
