# =====================================================================
# FUNecob — Configuração de ambiente (VPS COMPARTILHADA)
#   cp .env.example .env && nano .env && ./deploy/install.sh
# NUNCA versione o .env. Nenhum valor real deve entrar neste arquivo.
#
# IMPORTANTE: a Evolution API e o MongoDB já existentes na VPS
# (containers "evolution" e "mongodb-lab") NÃO são criados por este
# projeto. O FUNecob apenas os REUTILIZA através das variáveis abaixo.
# =====================================================================

# ---------------------------------------------------------------------
# DOMÍNIOS
# ---------------------------------------------------------------------
APP_DOMAIN=financeiro.funecob.com.br
API_DOMAIN=api.funecob.com.br
ACME_EMAIL=seu-email@funecob.com.br

SITE_URL=https://financeiro.funecob.com.br
PORTAL_BASE_URL=https://financeiro.funecob.com.br
ADDITIONAL_REDIRECT_URLS=https://financeiro.funecob.com.br,https://financeiro.funecob.com.br/*

TZ=America/Sao_Paulo

# ---------------------------------------------------------------------
# SUPABASE SELF-HOSTED — EXCLUSIVO DO FUNecob
# Não pode apontar para nenhum outro projeto da VPS.
# ANON_KEY e SERVICE_ROLE_KEY são JWTs assinados com JWT_SECRET
# (gerados automaticamente por ./deploy/genkeys.sh).
# ---------------------------------------------------------------------
SUPABASE_PUBLIC_URL=https://api.funecob.com.br
SUPABASE_PROJECT_ID=funecob
ANON_KEY=
SERVICE_ROLE_KEY=
PGRST_DB_SCHEMAS=public,storage,graphql_public

# ---------------------------------------------------------------------
# BANCO DE DADOS — PostgreSQL PRÓPRIO (volume funecob_db_data)
# Exposto SOMENTE em 127.0.0.1 (nunca publicamente).
# ---------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=postgres
POSTGRES_PORT=54322

# ---------------------------------------------------------------------
# AUTH (GoTrue)
# ---------------------------------------------------------------------
JWT_SECRET=
JWT_EXPIRY=3600
DISABLE_SIGNUP=false
MAILER_AUTOCONFIRM=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_ADMIN_EMAIL=no-reply@funecob.com.br
SMTP_SENDER_NAME=FUNecob

# ---------------------------------------------------------------------
# REALTIME
# ---------------------------------------------------------------------
REALTIME_ENC_KEY=
REALTIME_SECRET_KEY_BASE=

# ---------------------------------------------------------------------
# STORAGE (buckets: logos [público], receipts [privado])
# ---------------------------------------------------------------------
STORAGE_FILE_SIZE_LIMIT=52428800

# ---------------------------------------------------------------------
# EVOLUTION API — JÁ EXISTENTE NA VPS (NÃO É CRIADA POR ESTE PROJETO)
#
#   container: evolution   imagem: atendai/evolution-api:v1.6.0   porta: 8080
#
# Dentro do Docker "localhost" é o próprio container. Para alcançar a
# Evolution publicada na porta 8080 do HOST use host.docker.internal
# (o compose já adiciona host-gateway ao container de Edge Functions):
#
#   EVOLUTION_API_URL=http://host.docker.internal:8080
#
# Alternativas válidas:
#   * IP interno do host Docker:  http://172.17.0.1:8080
#   * Domínio público existente:  https://wa.seudominio.com.br
# NUNCA use http://localhost:8080 aqui.
# ---------------------------------------------------------------------
EVOLUTION_API_URL=http://host.docker.internal:8080
EVOLUTION_API_KEY=
EVOLUTION_WEBHOOK_SECRET=

# ---------------------------------------------------------------------
# WHATSAPP (limites de envio — fallback; o banco tem precedência)
# ---------------------------------------------------------------------
WHATSAPP_MAX_PER_MINUTE=8
WHATSAPP_MAX_PER_HOUR=180
WHATSAPP_MAX_PER_DAY=900

# ---------------------------------------------------------------------
# MERCADO PAGO
# ---------------------------------------------------------------------
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_NOTIFICATION_URL=https://api.funecob.com.br/functions/v1/gateway-create-payment

# ---------------------------------------------------------------------
# GEMINI / OCR (LOVABLE_API_KEY é opcional, apenas fallback)
# ---------------------------------------------------------------------
GEMINI_API_KEY=
LOVABLE_API_KEY=

# ---------------------------------------------------------------------
# AGENDADOR PRÓPRIO (container funecob-cron) — substitui o pg_cron do
# Supabase Cloud. Esta é a ÚNICA configuração de cron do projeto.
#   CRON_TICK_SECONDS -> intervalo (s) de whatsapp-sender e pix-ocr-retry
#   BILLING_CRON_HOUR -> hora local (00-23) do billing-cron diário
# ---------------------------------------------------------------------
CRON_TICK_SECONDS=120
BILLING_CRON_HOUR=08


# ---------------------------------------------------------------------
# SEGURANÇA
# BIP_API_KEY: chave da extensão Chrome / endpoint bip-receiver.
#   Gere com: openssl rand -hex 32
# BACKUP_PASSPHRASE: cifra o .env dentro dos backups.
# ---------------------------------------------------------------------
BIP_API_KEY=
BACKUP_PASSPHRASE=
BACKUP_RETENTION_DAYS=30

# ---------------------------------------------------------------------
# PORTAS PUBLICADAS NO HOST (todas em 127.0.0.1)
# Escolhidas para NÃO conflitar com 80/443/8080/5432/6543/8000.
# IMPORTANTE: valores numéricos devem conter SOMENTE números.
#   WEB_HTTP_PORT  -> frontend  em 127.0.0.1:54320
#   KONG_HTTP_PORT -> API/Kong  em 127.0.0.1:54321
#   POSTGRES_PORT  -> Postgres  em 127.0.0.1:54322 (definido acima)
# ---------------------------------------------------------------------
WEB_HTTP_PORT=54320
KONG_HTTP_PORT=54321


# ---------------------------------------------------------------------
# PROXY / HTTPS
# USE_OWN_PROXY=false  -> RECOMENDADO em VPS compartilhada.
#   O FUNecob não publica 80/443; aponte o proxy já existente para
#   127.0.0.1:${WEB_HTTP_PORT} e 127.0.0.1:${KONG_HTTP_PORT}.
#   Exemplos prontos em DEPLOY.md (Caddy, Nginx e Traefik).
#
# USE_OWN_PROXY=true   -> sobe o funecob-caddy (profile "proxy") e ele
#   passa a ocupar CADDY_HTTP_PORT/CADDY_HTTPS_PORT. Só habilite se
#   80/443 estiverem realmente livres, ou mude as portas abaixo.
# ---------------------------------------------------------------------
USE_OWN_PROXY=false
CADDY_BIND_IP=0.0.0.0
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443

# ---------------------------------------------------------------------
# FRONTEND (build-time — preenchidos pelo compose a partir de
# SUPABASE_PUBLIC_URL / ANON_KEY / PORTAL_BASE_URL)
# ---------------------------------------------------------------------
VITE_SUPABASE_URL=https://api.funecob.com.br
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=funecob
VITE_PORTAL_BASE_URL=https://financeiro.funecob.com.br
