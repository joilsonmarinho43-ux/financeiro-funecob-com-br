# =====================================================================
# FUNecob — Configuração de ambiente (VPS independente)
# Copie para .env e preencha com valores REAIS.
#   cp .env.example .env && nano .env
# NUNCA versione o arquivo .env. Nenhum valor real deve entrar aqui.
# =====================================================================

# ---------------------------------------------------------------------
# DOMAINS
# ---------------------------------------------------------------------
APP_DOMAIN=financeiro.funecob.com.br
API_DOMAIN=api.funecob.com.br
EVOLUTION_DOMAIN=wa.funecob.com.br
ACME_EMAIL=seu-email@funecob.com.br

# URL pública do frontend e do portal do cliente
SITE_URL=https://financeiro.funecob.com.br
PORTAL_BASE_URL=https://financeiro.funecob.com.br
ADDITIONAL_REDIRECT_URLS=https://financeiro.funecob.com.br,https://financeiro.funecob.com.br/*

TZ=America/Sao_Paulo

# ---------------------------------------------------------------------
# SUPABASE (self-hosted — instalação exclusiva do FUNecob)
# SUPABASE_PUBLIC_URL deve ser o domínio da API acima (Kong).
# ANON_KEY e SERVICE_ROLE_KEY são JWTs assinados com JWT_SECRET.
# Gere com: ./deploy/install.sh (ele oferece geração automática)
# ---------------------------------------------------------------------
SUPABASE_PUBLIC_URL=https://api.funecob.com.br
SUPABASE_PROJECT_ID=funecob
ANON_KEY=
SERVICE_ROLE_KEY=
KONG_HTTP_PORT=54321
PGRST_DB_SCHEMAS=public,storage,graphql_public

# ---------------------------------------------------------------------
# DATABASE (PostgreSQL PRÓPRIO do FUNecob — volume funecob_db_data)
# ---------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=postgres
POSTGRES_PORT=54322

# ---------------------------------------------------------------------
# AUTH (GoTrue)
# JWT_SECRET: mínimo 32 caracteres. Mesma chave usada por REST/Realtime/Storage.
# ---------------------------------------------------------------------
JWT_SECRET=
JWT_EXPIRY=3600
DISABLE_SIGNUP=false
MAILER_AUTOCONFIRM=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_ADMIN_EMAIL=no-reply@funecob.com.br
SMTP_SENDER_NAME=FUNecob

# ---------------------------------------------------------------------
# REALTIME
# ---------------------------------------------------------------------
REALTIME_ENC_KEY=
REALTIME_SECRET_KEY_BASE=

# ---------------------------------------------------------------------
# STORAGE (buckets: logos [público], receipts [privado])
# ---------------------------------------------------------------------
STORAGE_FILE_SIZE_LIMIT=52428800

# ---------------------------------------------------------------------
# EVOLUTION API (WhatsApp — instância própria do FUNecob)
# EVOLUTION_API_URL: usado pelas Edge Functions (rede interna do Docker).
# EVOLUTION_PUBLIC_URL: URL externa registrada nos webhooks.
# ---------------------------------------------------------------------
EVOLUTION_API_URL=http://funecob-evolution:8080
EVOLUTION_PUBLIC_URL=https://wa.funecob.com.br
EVOLUTION_API_KEY=
EVOLUTION_WEBHOOK_SECRET=

# ---------------------------------------------------------------------
# MONGODB (exclusivo do Evolution API do FUNecob)
# ---------------------------------------------------------------------
MONGO_USER=funecob
MONGO_PASSWORD=

# ---------------------------------------------------------------------
# WHATSAPP (limites de envio — fallback global; o banco tem precedência)
# ---------------------------------------------------------------------
WHATSAPP_MAX_PER_MINUTE=8
WHATSAPP_MAX_PER_HOUR=180
WHATSAPP_MAX_PER_DAY=900

# ---------------------------------------------------------------------
# MERCADO PAGO
# ---------------------------------------------------------------------
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_NOTIFICATION_URL=https://api.funecob.com.br/functions/v1/gateway-create-payment

# ---------------------------------------------------------------------
# GEMINI / OCR
# Provedor principal: GEMINI_API_KEY.
# LOVABLE_API_KEY é OPCIONAL (fallback). Sem nenhuma das duas, o
# comprovante segue para revisão manual — nada é baixado automaticamente.
# ---------------------------------------------------------------------
GEMINI_API_KEY=
LOVABLE_API_KEY=

# ---------------------------------------------------------------------
# CRON (pg_cron roda dentro do funecob-db)
# ---------------------------------------------------------------------
CRON_BILLING_SCHEDULE=0 11 * * *
CRON_WHATSAPP_SCHEDULE=*/2 * * * *

# ---------------------------------------------------------------------
# SECURITY
# BIP_API_KEY: chave da extensão Chrome / endpoint bip-receiver (64 hex).
#   Gere com: openssl rand -hex 32
# ---------------------------------------------------------------------
BIP_API_KEY=

# ---------------------------------------------------------------------
# CADDY / PORTAS DO HOST
# ---------------------------------------------------------------------
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443

# ---------------------------------------------------------------------
# FRONTEND (build-time — preenchidos automaticamente pelo compose a
# partir de SUPABASE_PUBLIC_URL / ANON_KEY / PORTAL_BASE_URL)
# ---------------------------------------------------------------------
VITE_SUPABASE_URL=https://api.funecob.com.br
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=funecob
VITE_PORTAL_BASE_URL=https://financeiro.funecob.com.br
